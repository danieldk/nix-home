{
  pkgs,
  config,
  ...
}:

{
  programs.nix-ld = {
    enable = true;
    libraries =
      with pkgs;
      [
        acl
        attr
        bzip2
        dbus
        expat
        fontconfig
        freetype
        fuse3
        icu
        libnotify
        libsodium
        libssh
        libunwind
        libusb1
        libuuid
        nspr
        nss
        stdenv.cc.cc.lib
        util-linux
        zlib
        zstd
      ]
      ++ lib.optionals (config.hardware.graphics.enable) [
        alsa-lib
        at-spi2-atk
        at-spi2-core
        atk
        cairo
        cups
        gdk-pixbuf
        glib
        gtk3
        libGL
        libappindicator-gtk3
        libdrm
        libglvnd
        libpulseaudio
        libx11
        libxcb
        libxcomposite
        libxcursor
        libxdamage
        libxext
        libxfixes
        libxi
        libxkbcommon
        libxkbfile
        libxrandr
        libxrender
        libxscrnsaver
        libxshmfence
        libxtst
        mesa
        pango
        pipewire
        vulkan-loader
      ];
  };
}
